[Unit]
Description=POLAR contact angle analysis
After=network.target

[Service]
User=polar
WorkingDirectory=/opt/polar
Environment=POLAR_DATA_DIR=/var/lib/polar
EnvironmentFile=/etc/polar.env
ExecStart=/opt/polar/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8765 --timeout 180 app:create_app()
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polar

[Install]
WantedBy=multi-user.target
